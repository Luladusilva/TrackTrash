{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=<host>;Port=5432;Database=TrackTrashDB;Username=production;Password=<contraseña>;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Jwt": {
    "Issuer": "TrackTrashAPI",
    "Audience": "TrackTrashClient",
    "AccessTokenExpirationHours": 4,
    "RefreshTokenExpirationDays": 7
  },
  "AllowedHosts": "*"
}
